{
  "name": "conflict-trades",
  "version": "2.0.0",
  "private": true,
  "description": "Geopolitical scenario desk + paper AI trader. The UI in web/ builds into ui-dist/; build.js stays dependency-free.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.mts",
    "build:ui": "vite build --config web/vite.config.mts && node scripts/check-size.mjs",
    "bake:land": "node scripts/bake-land.mjs",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run --config web/vite.config.mts",
    "build": "node build.js"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "d3-shape": "3.2.0",
    "motion": "12.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-shape": "3.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "world-atlas": "2.0.2"
  }
}
